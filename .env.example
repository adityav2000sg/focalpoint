NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Sign in with Apple is on by default. App Store guideline 4.8 requires it alongside
# Google sign-in, so only set this to false for a web-only deployment that will never
# be submitted to the App Store. Configure the Apple provider in Supabase before release.
NEXT_PUBLIC_APPLE_AUTH_ENABLED=true

# Optional AI features. Leave blank to use the deterministic coach and browser speech.
DASHSCOPE_API_KEY=
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.6-flash
QWEN_ASR_MODEL=qwen3-asr-flash
QWEN_VISION_MODEL=qwen3-vl-flash
